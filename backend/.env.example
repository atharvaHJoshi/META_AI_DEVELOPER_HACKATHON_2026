# ---------------------------------------------------------------------------
# MIRAIWERK AI API — local environment
# Copy to backend/.env (or to the repository root .env when running scripts from
# the monorepo root).
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://miraiwerk:miraiwerk_dev_pw@localhost:55434/miraiwerk

PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

AUTH_ALLOW_DEMO=true
# Development only. Production must set AUTH_ALLOW_DEMO=false and provide real users.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Production guardrails. APP_ENV=production makes the API refuse to start unless
# these are set safely (strong secrets, explicit hosts, HTTPS, real email).
APP_ENV=development
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
FRONTEND_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_PROTO=false

# Transactional email. Development uses Django's console backend; production
# must configure SMTP/SES-compatible delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MIRAIWERK AI <no-reply@miraiwerk.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Shared PostgreSQL-backed fixed windows. Adjust per environment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ACCOUNT=5
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_REGISTER_IP=5
RATE_LIMIT_PASSWORD_RESET_ACCOUNT=3
RATE_LIMIT_PASSWORD_RESET_IP=10
RATE_LIMIT_REFRESH_IP=120
RATE_LIMIT_AI_USER_DAILY=100
RATE_LIMIT_AI_WORKSPACE_DAILY=500

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=1
AI_FALLBACK_ON_ERROR=true

MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_TIMEOUT_MS=45000
META_MAX_RETRIES=2
META_TOOLS=true
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/oauth/meta/callback
META_GRAPH_VERSION=v21.0

# Frontend (Vite only reads VITE_* variables from its own environment)
VITE_API_BASE_URL=http://localhost:4000/api
# GroqCloud API key (OpenAI-compatible); optional — leave blank to disable.
GROQ_API_KEY=
