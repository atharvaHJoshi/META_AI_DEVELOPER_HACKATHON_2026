# ---------------------------------------------------------------------------
# MIRAIWERK AI — unified platform environment
# Copy this file to `.env` for the repository root (Vite/backend tooling) and to
# `backend/.env` when running the API directly from the backend workspace.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (docker-compose.yml maps this port to host 55434)
DATABASE_URL=postgres://miraiwerk:miraiwerk_dev_pw@localhost:55434/miraiwerk

# API
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Demo identity header. The full JWT bearer flow remains available; this flag
# enables the documented local demo identity for development and integration
# tests. Set it to false for production-only deployments.
AUTH_ALLOW_DEMO=true
# Generate your own with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Primary AI provider. Keep Gemini selected; when GEMINI_API_KEY is empty the
# API uses the labelled deterministic fallback. The fallback is always available.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=3
AI_FALLBACK_ON_ERROR=true

# Meta Model API and Meta OAuth — server-side only, never exposed to the browser.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_TIMEOUT_MS=45000
META_MAX_RETRIES=2
META_TOOLS=true
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/oauth/meta/callback
META_GRAPH_VERSION=v21.0

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
# GroqCloud API key (OpenAI-compatible); optional — leave blank to disable.
GROQ_API_KEY=
